#:import dp kivy.metrics.dp
#:import rgba kivy.utils.get_color_from_hex

<BodyLabel@Label>:
    font_name: "Cairo"
    color: rgba("#0A2540")
    halign: "right"
    valign: "middle"
    text_size: self.size

<TitleLabel@Label>:
    font_name: "Cairo"
    bold: True
    font_size: "22sp"
    color: rgba("#0A2540")
    halign: "right"
    valign: "middle"
    text_size: self.size

<PrimaryButton@Button>:
    font_name: "Cairo"
    background_normal: ""
    background_color: rgba("#00C896")
    color: 1,1,1,1
    bold: True
    size_hint_y: None
    height: dp(46)

<NavButton@Button>:
    font_name: "Cairo"
    background_normal: ""
    background_color: rgba("#0A2540")
    color: 1,1,1,1
    size_hint_y: None
    height: dp(42)

<StatCard@BoxLayout>:
    orientation: "vertical"
    padding: dp(12)
    spacing: dp(2)
    canvas.before:
        Color:
            rgba: 1,1,1,1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]

<ScreenBase@Screen>:
    BoxLayout:
        orientation: "vertical"
        canvas.before:
            Color:
                rgba: rgba("#F3F6F9")
            Rectangle:
                pos: self.pos
                size: self.size
        BoxLayout:
            size_hint_y: None
            height: dp(68)
            padding: dp(18), dp(8)
            canvas.before:
                Color:
                    rgba: rgba("#0A2540")
                Rectangle:
                    pos: self.pos
                    size: self.size
            Label:
                text: "NEXTER"
                font_name: "Cairo"
                font_size: "22sp"
                bold: True
                color: rgba("#00C896")
            Label:
                text: root.title_text if hasattr(root, "title_text") else ""
                font_name: "Cairo"
                color: 1,1,1,1
                halign: "right"
        ScreenManager:
        BoxLayout:
            size_hint_y: None
            height: dp(50)
            spacing: dp(2)
            NavButton:
                text: "الرئيسية"
                on_release: app.go("dashboard")
            NavButton:
                text: "الفواتير"
                on_release: app.go("invoices")
            NavButton:
                text: "المخزون"
                on_release: app.go("inventory")
            NavButton:
                text: "التقارير"
                on_release: app.go("reports")
            NavButton:
                text: "الإعدادات"
                on_release: app.go("settings")

<DashboardScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: dp(14)
        spacing: dp(12)
        Label:
            text: "لوحة التحكم"
            font_name: "Cairo"
            font_size: "24sp"
            bold: True
            color: rgba("#0A2540")
            size_hint_y: None
            height: dp(42)
            halign: "right"
        GridLayout:
            cols: 2
            spacing: dp(10)
            size_hint_y: None
            height: dp(180)
            StatCard:
                Label:
                    text: "مبيعات اليوم"
                    font_name: "Cairo"
                    color: rgba("#6B7280")
                Label:
                    id: sales
                    text: "0.00 ر.س"
                    font_name: "Cairo"
                    font_size: "18sp"
                    bold: True
                    color: rgba("#00C896")
            StatCard:
                Label:
                    text: "صافي الربح"
                    font_name: "Cairo"
                    color: rgba("#6B7280")
                Label:
                    id: profit
                    text: "0.00 ر.س"
                    font_name: "Cairo"
                    font_size: "18sp"
                    bold: True
                    color: rgba("#00C896")
            StatCard:
                Label:
                    text: "المصروفات"
                    font_name: "Cairo"
                    color: rgba("#6B7280")
                Label:
                    id: expenses
                    text: "0.00 ر.س"
                    font_name: "Cairo"
                    font_size: "18sp"
                    bold: True
                    color: rgba("#0A2540")
            StatCard:
                Label:
                    text: "عدد الفواتير"
                    font_name: "Cairo"
                    color: rgba("#6B7280")
                Label:
                    id: count
                    text: "0"
                    font_name: "Cairo"
                    font_size: "18sp"
                    bold: True
                    color: rgba("#0A2540")
        BoxLayout:
            orientation: "vertical"
            padding: dp(14)
            canvas.before:
                Color:
                    rgba: 1,1,1,1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(12)]
            Label:
                text: "أفضل العملاء"
                font_name: "Cairo"
                bold: True
                color: rgba("#0A2540")
                size_hint_y: None
                height: dp(36)
                halign: "right"
            ScrollView:
                BoxLayout:
                    id: best_box
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
        Widget:
    BoxLayout:
        size_hint_y: None
        height: dp(50)
        spacing: dp(2)
        NavButton:
            text: "الرئيسية"
            on_release: app.go("dashboard")
        NavButton:
            text: "الفواتير"
            on_release: app.go("invoices")
        NavButton:
            text: "المخزون"
            on_release: app.go("inventory")
        NavButton:
            text: "التقارير"
            on_release: app.go("reports")
        NavButton:
            text: "الإعدادات"
            on_release: app.go("settings")

<InvoicesScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: dp(14)
        spacing: dp(8)
        Label:
            text: "الفواتير والمبيعات"
            font_name: "Cairo"
            font_size: "23sp"
            bold: True
            color: rgba("#0A2540")
            size_hint_y: None
            height: dp(40)
            halign: "right"
        TextInput:
            id: subtotal
            hint_text: "المجموع قبل الضريبة"
            input_filter: "float"
            multiline: False
            font_name: "Cairo"
            size_hint_y: None
            height: dp(48)
        TextInput:
            id: notes
            hint_text: "اسم العميل أو ملاحظات الفاتورة"
            multiline: False
            font_name: "Cairo"
            size_hint_y: None
            height: dp(48)
        Label:
            text: "ضريبة القيمة المضافة: 15% — يتم احتسابها تلقائيًا"
            font_name: "Cairo"
            color: rgba("#6B7280")
            size_hint_y: None
            height: dp(30)
            halign: "right"
        PrimaryButton:
            text: "حفظ الفاتورة"
            on_release: root.save_invoice()
        Label:
            id: message
            text: ""
            font_name: "Cairo"
            color: rgba("#00C896")
            size_hint_y: None
            height: dp(42)
            halign: "right"
        Label:
            text: "آخر الفواتير"
            font_name: "Cairo"
            bold: True
            color: rgba("#0A2540")
            size_hint_y: None
            height: dp(35)
            halign: "right"
        ScrollView:
            Label:
                id: invoice_list
                text: "لا توجد فواتير بعد"
                font_name: "Cairo"
                color: rgba("#0A2540")
                text_size: self.width, None
                size_hint_y: None
                height: self.texture_size[1]
                halign: "right"
        Widget:
    BoxLayout:
        size_hint_y: None
        height: dp(50)
        spacing: dp(2)
        NavButton:
            text: "الرئيسية"
            on_release: app.go("dashboard")
        NavButton:
            text: "الفواتير"
            on_release: app.go("invoices")
        NavButton:
            text: "المخزون"
            on_release: app.go("inventory")
        NavButton:
            text: "التقارير"
            on_release: app.go("reports")
        NavButton:
            text: "الإعدادات"
            on_release: app.go("settings")

<PartnersScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: dp(14)
        spacing: dp(8)
        Label:
            text: "العملاء والموردون"
            font_name: "Cairo"
            font_size: "23sp"
            bold: True
            color: rgba("#0A2540")
            size_hint_y: None
            height: dp(40)
            halign: "right"
        TextInput:
            id: partner_name
            hint_text: "اسم العميل أو المورد"
            font_name: "Cairo"
            multiline: False
            size_hint_y: None
            height: dp(48)
        TextInput:
            id: phone
            hint_text: "رقم الهاتف"
            font_name: "Cairo"
            multiline: False
            size_hint_y: None
            height: dp(48)
        PrimaryButton:
            text: "إضافة جهة تعامل"
            on_release: root.save_partner()
        Label:
            id: message
            text: ""
            font_name: "Cairo"
            color: rgba("#00C896")
            size_hint_y: None
            height: dp(34)
            halign: "right"
        Label:
            text: "سجل جهات التعامل"
            font_name: "Cairo"
            bold: True
            color: rgba("#0A2540")
            size_hint_y: None
            height: dp(35)
            halign: "right"
        ScrollView:
            Label:
                id: partner_list
                text: "لا توجد جهات تعامل بعد"
                font_name: "Cairo"
                color: rgba("#0A2540")
                text_size: self.width, None
                size_hint_y: None
                height: self.texture_size[1]
                halign: "right"
        Widget:
    BoxLayout:
        size_hint_y: None
        height: dp(50)
        spacing: dp(2)
        NavButton:
            text: "الرئيسية"
            on_release: app.go("dashboard")
        NavButton:
            text: "الفواتير"
            on_release: app.go("invoices")
        NavButton:
            text: "المخزون"
            on_release: app.go("inventory")
        NavButton:
            text: "التقارير"
            on_release: app.go("reports")
        NavButton:
            text: "الإعدادات"
            on_release: app.go("settings")

<InventoryScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: dp(14)
        spacing: dp(7)
        Label:
            text: "المنتجات والمخزون"
            font_name: "Cairo"
            font_size: "23sp"
            bold: True
            color: rgba("#0A2540")
            size_hint_y: None
            height: dp(40)
            halign: "right"
        TextInput:
            id: product_name
            hint_text: "اسم المنتج"
            font_name: "Cairo"
            multiline: False
            size_hint_y: None
            height: dp(42)
        TextInput:
            id: barcode
            hint_text: "الباركود / SKU"
            font_name: "Cairo"
            multiline: False
            size_hint_y: None
            height: dp(42)
        BoxLayout:
            spacing: dp(6)
            TextInput:
                id: qty
                hint_text: "الكمية"
                input_filter: "float"
                multiline: False
                font_name: "Cairo"
            TextInput:
                id: price
                hint_text: "سعر البيع"
                input_filter: "float"
                multiline: False
                font_name: "Cairo"
            TextInput:
                id: minimum
                hint_text: "حد التنبيه"
                input_filter: "float"
                multiline: False
                font_name: "Cairo"
        PrimaryButton:
            text: "حفظ المنتج"
            on_release: root.save_product()
        Label:
            id: message
            text: ""
            font_name: "Cairo"
            color: rgba("#00C896")
            size_hint_y: None
            height: dp(30)
            halign: "right"
        ScrollView:
            Label:
                id: product_list
                text: "لا توجد منتجات بعد"
                font_name: "Cairo"
                color: rgba("#0A2540")
                text_size: self.width, None
                size_hint_y: None
                height: self.texture_size[1]
                halign: "right"
        Widget:
    BoxLayout:
        size_hint_y: None
        height: dp(50)
        spacing: dp(2)
        NavButton:
            text: "الرئيسية"
            on_release: app.go("dashboard")
        NavButton:
            text: "الفواتير"
            on_release: app.go("invoices")
        NavButton:
            text: "المخزون"
            on_release: app.go("inventory")
        NavButton:
            text: "التقارير"
            on_release: app.go("reports")
        NavButton:
            text: "الإعدادات"
            on_release: app.go("settings")

<ReportsScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: dp(14)
        spacing: dp(12)
        Label:
            text: "التقارير المالية"
            font_name: "Cairo"
            font_size: "23sp"
            bold: True
            color: rgba("#0A2540")
            size_hint_y: None
            height: dp(42)
            halign: "right"
        PrimaryButton:
            text: "تصدير التقارير إلى Excel"
            on_release: root.export_excel()
        Label:
            id: export_message
            text: ""
            font_name: "Cairo"
            color: rgba("#00C896")
            size_hint_y: None
            height: dp(34)
            halign: "right"
        ScrollView:
            Label:
                id: report
                text: "جارٍ تحميل التقرير..."
                font_name: "Cairo"
                font_size: "17sp"
                color: rgba("#0A2540")
                text_size: self.width, None
                size_hint_y: None
                height: self.texture_size[1]
                halign: "right"
        Widget:
    BoxLayout:
        size_hint_y: None
        height: dp(50)
        spacing: dp(2)
        NavButton:
            text: "الرئيسية"
            on_release: app.go("dashboard")
        NavButton:
            text: "الفواتير"
            on_release: app.go("invoices")
        NavButton:
            text: "المخزون"
            on_release: app.go("inventory")
        NavButton:
            text: "التقارير"
            on_release: app.go("reports")
        NavButton:
            text: "الإعدادات"
            on_release: app.go("settings")

<SettingsScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: dp(14)
        spacing: dp(9)
        Label:
            text: "الإعدادات"
            font_name: "Cairo"
            font_size: "23sp"
            bold: True
            color: rgba("#0A2540")
            size_hint_y: None
            height: dp(42)
            halign: "right"
        TextInput:
            id: company
            hint_text: "اسم الشركة"
            font_name: "Cairo"
            multiline: False
            size_hint_y: None
            height: dp(48)
        TextInput:
            id: tax
            hint_text: "الرقم الضريبي"
            font_name: "Cairo"
            multiline: False
            size_hint_y: None
            height: dp(48)
        PrimaryButton:
            text: "حفظ بيانات الشركة"
            on_release: root.save_company()
        PrimaryButton:
            text: "نسخ احتياطي لقاعدة البيانات (.db)"
            on_release: root.backup()
        Label:
            id: message
            text: "تُحفظ البيانات محليًا ولا تحتاج إلى اتصال بالإنترنت"
            font_name: "Cairo"
            color: rgba("#00C896")
            halign: "right"
            text_size: self.size
        Widget:
    BoxLayout:
        size_hint_y: None
        height: dp(50)
        spacing: dp(2)
        NavButton:
            text: "الرئيسية"
            on_release: app.go("dashboard")
        NavButton:
            text: "الفواتير"
            on_release: app.go("invoices")
        NavButton:
            text: "المخزون"
            on_release: app.go("inventory")
        NavButton:
            text: "التقارير"
            on_release: app.go("reports")
        NavButton:
            text: "الإعدادات"
            on_release: app.go("settings")
